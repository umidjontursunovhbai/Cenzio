    "icloud_sync_account_mismatch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some synced data came from a device signed in to Cenzio with a different Apple ID. iCloud Sync follows this iPhone's iCloud account, so use the same Apple ID for iCloud and for Cenzio on every device."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часть синхронизированных данных пришла с устройства, где вход в Cenzio выполнен с другим Apple ID. Синхронизация iCloud использует учетную запись iCloud этого iPhone, поэтому на всех устройствах используйте один Apple ID для iCloud и для Cenzio."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinxronlangan maʼlumotlarning bir qismi Cenzio‘ga boshqa Apple ID bilan kirilgan qurilmadan kelgan. iCloud sinxronlash shu iPhoneʼdagi iCloud akkauntiga bog‘liq. Shuning uchun har bir qurilmada iCloud va Cenzio uchun bitta Apple IDʼdan foydalaning."
          }
        }
      }
    },
    "icloud_sync_footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data syncs automatically with iCloud across all your devices."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные автоматически синхронизируются через iCloud на всех ваших устройствах."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Maʼlumotlaringiz iCloud orqali barcha qurilmalaringizda avtomatik sinxronlanadi."
          }
        }
      }
    },
    "icloud_sync_no_account_footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Sync uses the iCloud account in the Settings app. Sign in there with the same Apple ID on each device and allow Cenzio to use iCloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизация iCloud использует учетную запись iCloud из приложения «Настройки». Войдите там с одним Apple ID на каждом устройстве и разрешите Cenzio использовать iCloud."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud sinxronlash Sozlamalar ilovasidagi iCloud akkauntidan foydalanadi. Har bir qurilmada u yerga bitta Apple ID bilan kiring va Cenzio‘ga iCloudʼdan foydalanishga ruxsat bering."
          }
        }
      }
    },
