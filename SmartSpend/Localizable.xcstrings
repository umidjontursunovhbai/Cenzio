    "account_delete": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete Account"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Akkauntni o'chirish"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить аккаунт"
          }
        }
      }
    },
    "account_delete_auth_reason": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm deleting your Cenzio account"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Cenzio akkauntini o'chirishni tasdiqlang"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтвердите удаление аккаунта Cenzio"
          }
        }
      }
    },
    "account_delete_confirm_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All expenses, categories, budgets and settings will be deleted from this iPhone and from iCloud on all your devices. This can't be undone."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Barcha xarajatlar, kategoriyalar, byudjet va sozlamalar shu iPhone'dan va hamma qurilmalardagi iCloud'dan o'chadi. Qaytarib bo'lmaydi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все расходы, категории, бюджеты и настройки будут удалены с этого iPhone и из iCloud на всех ваших устройствах. Это действие нельзя отменить."
          }
        }
      }
    },
    "account_delete_confirm_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete your account?"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Akkauntni o'chirasizmi?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить аккаунт?"
          }
        }
      }
    },
    "account_delete_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account couldn't be deleted because iCloud is unreachable. Nothing was deleted. Check your connection and try again."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud bilan aloqa yo'qligi sababli akkaunt o'chmadi. Hech narsa o'chirilmadi. Internetni tekshirib, qayta urinib ko'ring."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось удалить аккаунт: нет связи с iCloud. Ничего не удалено. Проверьте подключение и повторите попытку."
          }
        }
      }
    },
    "account_delete_footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes your Cenzio account and all your data on this iPhone and in iCloud, on every device. This can't be undone."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Akkaunt va barcha ma'lumotlar shu iPhone'dan va iCloud'dan, hamma qurilmalarda o'chadi. Qaytarib bo'lmaydi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет аккаунт Cenzio и все ваши данные на этом iPhone и в iCloud на всех устройствах. Это действие нельзя отменить."
          }
        }
      }
    },
    "account_local_data_footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your expenses are stored on this iPhone and in your own iCloud. Signing out doesn't delete them."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Xarajatlaringiz shu iPhone'da va sizning iCloud'ingizda saqlanadi. Chiqish ularni o'chirmaydi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши расходы хранятся на этом iPhone и в вашем iCloud. При выходе они не удаляются."
          }
        }
      }
    },
    "account_not_signed_in": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not signed in"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirilmagan"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход не выполнен"
          }
        }
      }
    },
    "account_sign_in_footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing in is optional. Cenzio works the same without an account."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirish ixtiyoriy. Cenzio akkauntsiz ham xuddi shunday ishlaydi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход необязателен. Cenzio работает так же и без аккаунта."
          }
        }
      }
    },
    "account_sign_out": {
      "extractionState": "manual",
      "localizations": {
