    "apply_category_to_all_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are other expenses with the title '%@'. Would you like to apply the same category to all of them?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Есть другие расходы с названием «%@». Применить эту категорию ко всем?"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” nomli boshqa xarajatlar ham bor. Shu kategoriyani hammasiga qo‘llaysizmi?"
          }
        }
      }
    },
