    "budget_info_alerts_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the Dashboard, the Categories card turns a category orange or red when it is near or over its limit, and Insights lists them too. Tap a category on the Dashboard to jump straight to its budget here. Alerts stay inside the app; Cenzio doesn't send notifications for budgets."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На панели «Обзор» в карточке «Категории» категория становится оранжевой или красной, когда она близка к лимиту или превышает его. В «Аналитике» такие категории тоже видны. Нажмите на категорию на панели, чтобы сразу открыть ее бюджет. Предупреждения видны только в приложении: Cenzio не присылает уведомления о бюджетах."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bosh sahifadagi Kategoriyalar kartasida limitga yaqin yoki undan oshgan kategoriya to‘q sariq yoki qizil bo‘ladi. Ular Tahlil bo‘limida ham ko‘rsatiladi. Bosh sahifada kategoriyani bossangiz, shu yerdagi byudjeti ochiladi. Ogohlantirishlar faqat ilova ichida bo‘ladi, Cenzio byudjet bo‘yicha bildirishnoma yubormaydi."
          }
        }
      }
    },
    "budget_info_alerts_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where you'll see alerts"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Где видны предупреждения"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogohlantirishlar qayerda chiqadi"
          }
        }
      }
    },
    "budget_info_calc_active": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only categories that are switched on with a limit above 0 are tracked. The totals at the top add up just those categories."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Учитываются только включенные категории с лимитом больше 0. Итоги вверху складываются только из них."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Faqat yoqilgan va limiti 0 dan katta kategoriyalar hisobga olinadi. Yuqoridagi jami summalar faqat shu kategoriyalardan yig‘iladi."
          }
        }
      }
    },
    "budget_info_calc_category": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each category is measured on its own: what you spent in that category this month, divided by its monthly limit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая категория считается отдельно: сколько вы потратили в ней за этот месяц, деленное на ее месячный лимит."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Har bir kategoriya alohida hisoblanadi: shu oy shu kategoriyaga sarflangan summa uning oylik limitiga bo‘linadi."
          }
        }
      }
    },
    "budget_info_calc_month": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only expenses dated in the current calendar month count, from the 1st to the last day. Each month starts fresh, and nothing carries over."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Учитываются только расходы текущего календарного месяца, с 1-го по последнее число. Каждый месяц начинается с нуля, остаток не переносится."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Faqat joriy oyning 1-kunidan oxirgi kunigacha bo‘lgan xarajatlar hisobga olinadi. Har oy noldan boshlanadi, hech narsa keyingi oyga o‘tmaydi."
          }
        }
      }
    },
    "budget_info_calc_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How it's calculated"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как это считается"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qanday hisoblanadi"
          }
        }
      }
    },
    "budget_info_example": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Example: %@ has a %@ limit, so the warning starts at %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пример: у категории %@ лимит %@, поэтому предупреждение появится с %@."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Misol: %@ limiti %@, shuning uchun ogohlantirish %@ dan boshlanadi."
          }
        }
      }
    },
    "budget_info_more_goals": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spending goals are separate: they add up every expense ever recorded in their category, not just this month, and compare it with your target."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цели по расходам работают отдельно: они суммируют все расходы в своей категории за все время, а не только за месяц, и сравнивают с целью."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Xarajat maqsadlari alohida: ular faqat shu oyni emas, kategoriyadagi barcha xarajatlarni qo‘shib, maqsadingiz bilan solishtiradi."
          }
        }
      }
    },
    "budget_info_more_suggest": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggest from history sets each limit to your average monthly spending in that category over the last 2 months, plus 5%."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Предложить по истории» ставит каждому лимиту ваш средний месячный расход в этой категории за последние 2 месяца плюс 5%."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "«Tarixdan taklif» har bir limitni shu kategoriyadagi oxirgi 2 oylik o‘rtacha oylik xarajatingiz va yana 5% qilib belgilaydi."
          }
        }
      }
    },
    "budget_info_more_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Good to know"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полезно знать"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilib qo‘ying"
          }
        }
      }
    },
    "budget_info_state_near": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spent 80% of the limit or more. An early warning while there's still room to adjust."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потрачено 80% лимита или больше. Раннее предупреждение, пока еще можно что-то изменить."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Limitning 80% yoki undan ko‘pi sarflandi. Hali tuzatishga vaqt borligida erta ogohlantirish."
          }
        }
      }
    },
    "budget_info_state_on_track": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spent less than 80% of the limit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потрачено меньше 80% лимита."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Limitning 80% idan kami sarflandi."
          }
        }
      }
    },
    "budget_info_state_over": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spent more than the limit. The amount over is shown in red."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потрачено больше лимита. Превышение показано красным."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Limitdan ko‘p sarflandi. Oshgan summa qizil rangda ko‘rsatiladi."
          }
        }
      }
    },
    "budget_info_states_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the colors mean"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что означают цвета"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ranglar nimani bildiradi"
          }
        }
      }
    },
    "budget_info_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How budget goals work"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как работают цели бюджета"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Byudjet maqsadlari qanday ishlaydi"
          }
        }
      }
    },
    "budget_info_why_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A monthly limit turns \"I spend too much on food\" into a number you can watch. You see trouble in the middle of the month, while there is still time to adjust, instead of after the money is gone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Месячный лимит превращает «я слишком много трачу на еду» в число, за которым можно следить. Вы видите проблему в середине месяца, пока еще есть время что-то изменить, а не когда деньги уже потрачены."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oylik limit \"ovqatga juda ko‘p sarflayapman\" degan fikrni kuzatsa bo‘ladigan raqamga aylantiradi. Muammoni pul tugagandan keyin emas, oy o‘rtasida, hali tuzatishga vaqt borligida ko‘rasiz."
          }
        }
      }
    },
    "budget_info_why_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why set them"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зачем их ставить"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Nima uchun kerak"
          }
        }
      }
    },
