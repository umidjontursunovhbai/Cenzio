          }
        }
      }
    },
    "account_sign_out_confirm_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your expenses stay on this iPhone, and you can keep using Cenzio without an account."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Xarajatlar shu iPhone'da qoladi. Cenzio'dan akkauntsiz ham foydalanish mumkin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши расходы останутся на этом iPhone, и вы сможете пользоваться Cenzio без аккаунта."
          }
        }
      }
    },
