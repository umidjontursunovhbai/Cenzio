    "coach_tip_budget_exceeded": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alert: You've exceeded your monthly budget for %@. Let's try to slow down in this category."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Внимание: вы превысили месячный бюджет на %@. Постарайтесь тратить меньше в этой категории."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Diqqat: %@ uchun oylik byudjetdan oshdingiz. Bu kategoriyada kamroq sarflashga harakat qiling."
          }
        }
      }
    },
    "coach_tip_budget_warning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Caution: You've used %d%% of your %@ budget. You're approaching your limit!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Осторожно: вы израсходовали %d%% бюджета на %@. Лимит уже близко!"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ehtiyot bo‘ling: byudjetning %d%% qismi ishlatildi (%@). Limit yaqin!"
          }
        }
      }
    },
    "coach_tip_savings_success": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Excellent work! Your spending is down 20% compared to last week. You're becoming a savings master!"
