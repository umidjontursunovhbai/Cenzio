        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отличная работа! Ваши расходы на 20% ниже, чем на прошлой неделе. Вы становитесь мастером экономии!"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoyib! Xarajatlaringiz o‘tgan haftadan 20% kam. Tejash ustasiga aylanyapsiz!"
          }
        }
      }
    },
    "coach_tip_spending_surge": {
